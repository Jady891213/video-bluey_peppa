p","display_path":"/ebook/assets/gift-ill-024-994e168f58dc.webp","image_alt":"送给布鲁伊的画","start_sec":94.66122448979591,"end_sec":99.81614512471656,"duration_sec":5.154920634920643},{"id":"G025","title":"添上足球","chapter":"act-2","lines":[{"id":"GIFT-L033","speaker":"佩奇","text":"我们一起踢球！","start_sec":99.81614512471656,"end_sec":101.92916099773242}],"image_path":"/ebook/assets/gift-ill-025-4259cab29dfd-full.webp","display_path":"/ebook/assets/gift-ill-025-4259cab29dfd.webp","image_alt":"添上足球","start_sec":99.81614512471656,"end_sec":102.10916099773243,"duration_sec":2.293015873015875},{"id":"G026","title":"恐龙也要来","chapter":"act-2","lines":[{"id":"GIFT-L034","speaker":"乔治","text":"还要把恐龙画上！","start_sec":102.10916099773243,"end_sec":104.74462585034014},{"id":"GIFT-L035","speaker":"佩奇","text":"好吧，不过它不能吃足球！","start_sec":104.92462585034014,"end_sec":108.23346938775511}],"image_path":"/ebook/assets/gift-ill-026-7647a5543b79-full.webp","display_path":"/ebook/assets/gift-ill-026-7647a5543b79.webp","image_alt":"恐龙也要来","start_sec":102.10916099773243,"end_sec":108.4134693877551,"duration_sec":6.304308390022669},{"id":"G027","title":"恐龙站在草地上","chapter":"act-2","lines":[{"id":"GIFT-L036","speaker":"乔治","text":"它也想跟我们踢球！","start_sec":108.4134693877551,"end_sec":111.79197278911565},{"id":"GIFT-L037","speaker":"佩奇","text":"那让它在旁边给大家加油吧。","start_sec":111.97197278911564,"end_sec":116.00063492063492}],"image_path":"/ebook/assets/gift-ill-027-1f96fecfcd71-full.webp","display_path":"/ebook/assets/gift-ill-027-1f96fecfcd71.webp","image_alt":"恐龙站在草地上","start_sec":108.4134693877551,"end_sec":116.18063492063492,"duration_sec":7.767165532879815},{"id":"G028","title":"猪爸爸准备守门","chapter":"act-2","lines":[{"id":"GIFT-L038","speaker":"猪爸爸","text":"那我来带足球，你们带小礼物。","start_sec":116.18063492063492,"end_sec":119.04829931972789},{"id":"GIFT-L039","speaker":"佩奇","text":"爸爸，你也要跟我们一起踢！","start_sec":119.2282993197279,"end_sec":122.1772335600907}],"image_path":"/ebook/assets/gift-ill-028-c2f8fae98aaf-full.webp","di